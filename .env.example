# true  = use dummy JSON (no backend needed)
# false or unset = call the real Django API
VITE_USE_MOCK=false

# Backend API base URL (store uses it when VITE_USE_MOCK=false; the admin panel always uses it)
VITE_API_BASE=https://e-commerce-candle-backend.onrender.com/api
# For local development, comment the live URL above and use:
# VITE_API_BASE=http://localhost:8000/api

# Razorpay public key (used when VITE_USE_MOCK=false)
VITE_RAZORPAY_KEY=rzp_test_xxxxxxxx

# WhatsApp number with country code, no + sign
VITE_WHATSAPP=919999999999
